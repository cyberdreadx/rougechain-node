# ── RougeChain BTC Bridge Relayer config ──
# Copy to btc-bridge-relayer.env, fill in, and run:  npm run relayer:btc
# This process holds a HOT Bitcoin key. Run it as a singleton on a secured host.
# The daemon holds no Bitcoin key — it only verifies payouts this relayer reports.

# Daemon API base (the RougeChain node this relayer serves).
CORE_API_URL=http://localhost:5101

# Shared secret; must equal the daemon's BRIDGE_RELAYER_SECRET. Authorizes fulfill calls.
BRIDGE_RELAYER_SECRET=

# Custody private key in WIF format. THE HOT KEY. Fund the address it derives (printed on boot).
# Set the daemon's QV_BRIDGE_BTC_CUSTODY to that exact derived address so it watches deposits there.
BRIDGE_BTC_CUSTODY_WIF=

# Network: mainnet | testnet. MUST match the daemon's QV_BRIDGE_BTC_NETWORK.
QV_BRIDGE_BTC_NETWORK=mainnet

# Esplora API base (optional; network-aware default is mempool.space).
# QV_BTC_ESPLORA_PRIMARY=https://mempool.space/api

# Confirmations before fulfilling a payout (should match the daemon's setting).
QV_BRIDGE_BTC_MIN_CONFIRMATIONS=2

# Per-payout ceiling in satoshis (0 = no cap). Bounds the blast radius of any single bug.
BTC_MAX_WITHDRAW_SATS=0

# Fee target in blocks for fee estimation.
BTC_FEE_TARGET_BLOCKS=3

# SAFETY: broadcasting is OFF by default (dry-run). Set to true only after a testnet round-trip.
BTC_RELAYER_LIVE=false

# Poll cadence (ms) and max broadcast attempts per withdrawal.
POLL_INTERVAL_MS=15000
MAX_RETRIES=3

# Directory for the idempotency state file (.btc-relayer-state.json). Keep it persistent!
BRIDGE_DATA_DIR=.
