# Bridge relayer + daemon shared environment (template).
# Copy to bridge-relayer.env and fill in real values. NEVER commit the real file.
# Consumed via systemd EnvironmentFile by both quantum-vault.service and bridge-relayer.service.

CORE_API_URL=http://localhost:5100
BRIDGE_CUSTODY_PRIVATE_KEY=0x<custody-eoa-private-key>
ROUGE_BRIDGE_ADDRESS=0x0c09C764AdC024497729cd452ECfeE8869d35d83
XRGE_BRIDGE_VAULT=0xb3f52f2C1bD5692494655cF59d8EE296D23bFAb5
BRIDGE_RELAYER_SECRET=<shared-secret-daemon-and-relayer>
# RPC URL the relayer uses (var name must be BASE_RPC_URL — the relayer reads this).
BASE_RPC_URL=https://mainnet.base.org
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
POLL_INTERVAL_MS=10000
BRIDGE_DATA_DIR=/srv/rougechain
BASE_CHAIN=mainnet

# Failure alerting + auto-refund (optional)
# ALERT_WEBHOOK_URL=        # Slack/Discord incoming webhook for repeated-failure alerts
AUTO_REFUND=true           # Re-mint burned tokens to the owner once the daemon flags refund-eligible

# Deposit watcher: scan Base for deposit events and auto-claim on L1 (no browser step)
DEPOSIT_WATCHER=true
# DEPOSIT_WATCH_FROM_BLOCK= # Optional start block; default anchors at chain head (no backfill)
# DEPOSIT_MAX_BLOCK_SPAN=2000  # Max blocks scanned per poll (caps cold-start range)
