server {
    listen 80;
    listen [::]:80;
    server_name api.rougechain.io;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name api.rougechain.io;

    ssl_certificate /etc/letsencrypt/live/api.rougechain.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.rougechain.io/privkey.pem;

    # --- SECURITY PAUSE 2026-08-19: bridge write routes + unverified token freeze ---
    # Contains three unauth mainnet bugs: XRGE infinite-mint, qETH deposit-theft,
    # token-freeze signature bypass. Daemon bridge is ALSO disabled (custody/vault
    # unset); these nginx 403s are defense-in-depth + the only cover for token-freeze.
    # Remove this block to restore once the code fix is deployed & verified.
    location ^~ /api/bridge/withdraw      { return 403; }
    location ^~ /api/bridge/xrge/withdraw { return 403; }
    location = /api/bridge/deposit/auto-claim { return 403; }
    location = /api/bridge/admin/reclaim      { return 403; }

    # WebSocket — not subject to CORS preflight, so no CORS headers here.
    # Must precede the /api/ block's OPTIONS short-circuit (longest prefix wins).
    location /api/ws {
        proxy_pass http://127.0.0.1:5100/api/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
    }

    # Public read/broadcast API. Wildcard CORS, matching testnet: the API has no
    # cookie or session auth (every state-changing tx is signed with the wallet
    # key), so an origin allowlist protects nothing a plain curl can't already
    # reach. Mirrors how public chain RPCs (Infura/Alchemy) serve browsers.
    # proxy_hide_header strips the daemon's own CorsLayer header first — two
    # Access-Control-Allow-Origin values on one response makes browsers reject it.
    location /api/ {
        proxy_hide_header Access-Control-Allow-Origin;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, PATCH, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Authorization, X-API-Key" always;
        add_header Access-Control-Max-Age 86400 always;
        proxy_pass http://127.0.0.1:5100;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        if ($request_method = OPTIONS) { return 204; }
    }

    location / {
        proxy_pass http://127.0.0.1:5100;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
