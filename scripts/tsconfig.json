{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "bridge-relayer.ts",
    "bridge-relayer-core.ts",
    "bridge-relayer-core.test.ts",
    "bridge-canonical-id.vector.test.ts"
  ]
}
